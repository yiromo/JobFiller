SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Optional — leave MIMO_API_KEY empty to run heuristic-only (no LLM call, no
# error). Rotate any key that was ever pasted into a chat before using it here.
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.6-flash
MIMO_VISION_MODEL=mimo-v2.6-flash

# Optional — leave TAVILY_API_KEY empty to disable the "Analyze" feature (it
# returns 503 rather than fabricating company/statistics data without search).
TAVILY_API_KEY=

# Create an app at https://my.telegram.org, then run `telegram_login` locally.
# Keep the generated session in core/src/data (the persistent Docker volume).
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=
TELEGRAM_CHANNEL_TITLE=Digital nomads. Work from anywhere
OPPORTUNITY_MIN_SCORE=75

JOB_SOURCE_URLS=
HUNTER_HEADLESS=virtual
HUNTER_MIN_SCORE=75
HUNTER_BROAD_MIN_SCORE=50
HUNTER_MAX_APPLIES_PER_RUN=10
HUNTER_MAX_NEW_PER_RUN=40
HUNTER_MAX_APPLIES_PER_DAY=50
HUNTER_SITE_PRIORITY=ats,dsml,indeed,linkedin,hh
HUNTER_PARALLEL_SITES=2
HUNTER_ATS_SEARCH_HOURS=48
HUNTER_SKIP_EMPLOYERS=Jobgether,Lensa,JobLeads,micro1,Prolific,RemoteHunter,Turing,Jobot,TalentHop,Torentify,TaskVerse,Wiraa,Ladders,The Ai Training Company
HUNTER_REJECTION_COOLDOWN_DAYS=30
HUNTER_STACK=
HUNTER_EXCLUDED_SKILLS=C,C++,Rust
HUNTER_SKIP_TITLES=no-code,low-code,no code,low code,nocode,lowcode,project manager,product manager,program manager,delivery manager,scrum master,product owner,business analyst
HUNTER_FLAGSHIP_EMPLOYERS=GitLab,GitHub,Microsoft,Google,Apple,Amazon,Meta,Netflix,Stripe,Coinbase,Grafana Labs,Temporal Technologies,Canonical,Elastic,Reddit,Revolut,Deel,Figma,Atlassian,MongoDB,Docker,Mozilla,ElevenLabs,Affirm,Samsara,LaunchDarkly,Binance,Supabase,Vercel,Kraken,Twilio,Dropbox,Confluent,Datadog,HashiCorp,Cloudflare,Shopify,Spotify,JetBrains,Red Hat
HUNTER_NAVIGATOR=on
HUNTER_NAVIGATOR_STEPS=25
HUNTER_NAVIGATOR_LINKEDIN=rehearse
HUNTER_NAVIGATOR_INDEED=rehearse
HUNTER_NAVIGATOR_DSML=
HUNTER_NAVIGATOR_ATS=
HUNTER_EXTERNAL_APPLY=off
HUNTER_CONTACT_PHONE=
HUNTER_CONTACT_CITY=
HUNTER_FACTS=
HUNTER_NOTIFY_TELEGRAM=false
HUNTER_NOTIFY_DESKTOP=true
HUNTER_CAPTCHA_WAIT_MINUTES=5
HUNTER_CAPTCHA_BACKOFF_MINUTES=5,30,60,180,480
HUNTER_MAIL_ACCOUNTS=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
HUNTER_MAIL_PER_RUN=150
