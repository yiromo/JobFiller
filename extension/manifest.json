{
  "manifest_version": 3,
  "name": "Job Filler",
  "version": "0.2.0",
  "description": "Scans a job application form and fills it from your CV via the local job-filler core API.",
  "browser_specific_settings": {
    "gecko": {
      "id": "job-filler@yiromo.dev",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": ["personallyIdentifyingInfo", "websiteContent"]
      }
    }
  },
  "permissions": ["scripting", "storage"],
  "host_permissions": [
    "<all_urls>",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "background": {
    "scripts": ["src/background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/panel.js"],
      "run_at": "document_idle"
    }
  ]
}
